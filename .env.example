# SalesSphere Environment Configuration

# Server Ports
PORT=8001
HOST=127.0.0.1

# Operational & Warehouse Database Paths (Default SQLite paths relative to project root)
OP_DB_PATH=database/operational.db
DW_DB_PATH=database/ecommerce_dw.db

# Authoritative Transaction Dataset
AUTHORITATIVE_DATASET_CSV=data/salesphere_unified_dataset_v2.csv

# Default Store Manager Credentials
MANAGER_ADMIN_EMAIL=admin@salesphere.in
MANAGER_ADMIN_PASSWORD=Manager@1234

# Default Customer Demo Credentials
DEMO_CUSTOMER_EMAIL=demo@salesphere.in
DEMO_CUSTOMER_PASSWORD=Demo@1234

# Frontend Configuration (frontend/.env)
# VITE_API_BASE_URL=http://localhost:8001/api
